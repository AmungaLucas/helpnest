# HelpNest media subdomain — hardening + signed-URL routing.
# This document root must contain ONLY this file, stream.php, receive.php and
# disk-report.php. Image bytes NEVER live here — they stay in the storage root
# defined in helpnest-media.config.php (outside the webroot).
# NOTE: disk-report.php is CLI-only (cPanel cron) and stays DENIED to the web.

RewriteEngine On

# Pretty signed-URL route: /s/<group>/<key>?v=&exp=&sig=  ->  stream.php
# The query string (v, exp, sig) is preserved automatically by QSA.
RewriteRule ^s/([a-z]+)/([0-9a-f-]{36})/?$ stream.php?group=$1&key=$2 [QSA,L]

# Whitelist the two endpoints; deny everything else in this directory so
# nothing accidentally dropped here can ever be served.
<FilesMatch "^(stream|receive)\.php$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# No directory listings, ever.
Options -Indexes
